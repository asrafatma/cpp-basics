{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build and Run C++",
      "command": "g++ -g \"${file}\" -o \"${workspaceFolder}/bin/${fileBasenameNoExtension}.exe\" ; & \"${workspaceFolder}/bin/${fileBasenameNoExtension}.exe\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}